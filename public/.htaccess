<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirección permanente de URLs antiguas de provincias
  RewriteRule ^provincia/(.+)$ /provincias/$1 [R=301,L]

  # React Router SPA
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
