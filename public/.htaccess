<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirección permanente de URLs antiguas de provincias
  RewriteRule ^provincia/(.+)$ /provincias/$1 [R=301,L]

  # --- Social previews (Fase 2A: Discursos) ---
  # Normalizar: las URLs canónicas de discursos individuales NO llevan
  # trailing slash. Si alguien pide la versión con "/", redirigir de forma
  # permanente a la versión sin slash (evita contenido duplicado / canonical
  # inconsistente).
  RewriteRule ^discursos/([^/]+)/$ /discursos/$1 [R=301,L]

  # Si existe un HTML estático pre-generado para este discurso (ver
  # scripts/generate-social-previews.mjs), servirlo de forma INTERNA, sin
  # cambiar la URL visible y sin redirect. Debe ejecutarse ANTES del
  # fallback general de React Router. Si el archivo no existe (slug
  # inexistente), esta regla no aplica y se sigue al fallback SPA normal.
  RewriteCond %{DOCUMENT_ROOT}/_social/discursos/$1.html -f
  RewriteRule ^discursos/([^/]+)$ /_social/discursos/$1.html [L]

  # --- Social previews (visitas provinciales individuales) ---
  # Solo rutas de dos segmentos: /provincias/:provinciaSlug/:visitaSlug
  # El índice /provincias/:provinciaSlug no se normaliza ni se reescribe acá.
  RewriteRule ^provincias/([^/]+)/([^/]+)/$ /provincias/$1/$2 [R=301,L]

  # $1 y $2 de RewriteCond corresponden a la RewriteRule inmediatamente
  # siguiente (provinciaSlug y visitaSlug), no a capturas de reglas previas.
  RewriteCond %{DOCUMENT_ROOT}/_social/provincias/$1/$2.html -f
  RewriteRule ^provincias/([^/]+)/([^/]+)$ /_social/provincias/$1/$2.html [L]

  # --- Social previews (actividades individuales de Senado) ---
  # Solo rutas de tres segmentos: /senado/:tema/:anio/:actividadSlug
  # /senado/:tema y /senado/:tema/:anio no se normalizan ni se reescriben acá.
  RewriteRule ^senado/([^/]+)/([^/]+)/([^/]+)/$ /senado/$1/$2/$3 [R=301,L]

  # $1 $2 $3 de RewriteCond corresponden a la RewriteRule inmediatamente
  # siguiente (tema, anio, actividadSlug), no a capturas de reglas previas.
  RewriteCond %{DOCUMENT_ROOT}/_social/senado/$1/$2/$3.html -f
  RewriteRule ^senado/([^/]+)/([^/]+)/([^/]+)$ /_social/senado/$1/$2/$3.html [L]

  # React Router SPA
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
